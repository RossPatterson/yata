&CONTROL OFF NOMSG
CP SPOOL CON PURGE TO * START
&ERROR &CONTINUE
 
&EXITRC = 0
 
*** TEST 1 ***
&TYPE Test 1: Create and verify an archive
&MYRC = 0
* Prepare
&ERROR &EXIT &RETCODE
EXECUTIL FREEADDR
&READ VARS &CUU
EXECUTIL FREEMODE
&READ VARS &DISK
CP DEF T3350 &CUU 5
SET CMSTYPE HT
&STACK LIFO T1
&STACK LIFO YES
FORMAT &CUU &DISK
SET CMSTYPE RT
RENAME ARCHIVE YATA A = ORIG =
&ERROR &CONTINUE
SENTRIES
&NNEW = &RETCODE
LISTFILE TEST* EXEC A ( EXEC
EXEC EXPLOIT COPY &LITERAL &FN EXEC A = = &DISK (OLDD
* Test
&CONTROL CMS NOMSG
YATA -C -D &DISK
&MYRC = &MYRC + &RETCODE
* Verify
COMPARE ARCHIVE ORIG A ARCHIVE YATA A
&MYRC = &MYRC + &RETCODE
&CONTROL OFF NOMSG
* Cleanup
&ERROR &EXIT &RETCODE
ERASE ARCHIVE YATA A
RENAME ARCHIVE ORIG A = YATA =
SET CMSTYPE HT
RELEASE &DISK (DET
SET CMSTYPE RT
&EXITRC = &EXITRC + &MYRC
 
*** TEST 2 ***
&TYPE Test 2: Extract and verify an archive
&MYRC = 0
* Prepare
&ERROR &EXIT &RETCODE
EXECUTIL FREEADDR
&READ VARS &CUU
EXECUTIL FREEMODE
&READ VARS &DISK
CP DEF T3350 &CUU 5
SET CMSTYPE HT
&STACK LIFO T2
&STACK LIFO YES
FORMAT &CUU &DISK
SET CMSTYPE RT
&ERROR &CONTINUE
MAKEBUF
SENTRIES
&NORIG = &RETCODE
LISTFILE TEST* EXEC A ( STACK
SENTRIES
&NORIG = &RETCODE - &NORIG
DROPBUF
* Test
&CONTROL CMS NOMSG
YATA -X -F ARCHIVE YATA A -D &DISK
&MYRC = &MYRC + &RETCODE
&CONTROL OFF NOMSG
* Verify new vs. orig
SENTRIES
&NNEW = &RETCODE
LISTFILE TEST* EXEC &DISK ( STACK
SENTRIES
&NNEW = &RETCODE - &NNEW
&ERROR &CONTINUE
&CONTROL CMS NOMSG
&LOOP -T2A &NNEW
    &READ VARS &FN
    COMPARE &FN EXEC A &FN EXEC &DISK
    &MYRC = &MYRC + &RETCODE
    -T2A
&CONTROL OFF NOMSG
* Verify orig vs. new
SENTRIES
&NNEW = &RETCODE
LISTFILE TEST* EXEC A ( STACK
SENTRIES
&NNEW = &RETCODE - &NNEW
&ERROR &CONTINUE
&CONTROL CMS NOMSG
&LOOP -T2B &NNEW
    &READ VARS &FN
    COMPARE &FN EXEC A &FN EXEC &DISK
    &MYRC = &MYRC + &RETCODE
    -T2B
&CONTROL OFF NOMSG
* Cleanup
SET CMSTYPE HT
RELEASE &DISK (DET
SET CMSTYPE RT
&EXITRC = &EXITRC + &MYRC
 
&EXIT &EXITRC
